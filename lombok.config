# Lombok settings for the whole repository (see docs/adr/0010-lombok.md)
config.stopBubbling = true

# Mark generated code, so coverage and static analysis tools skip it
lombok.addLombokGeneratedAnnotation = true

# @Slf4j creates a field named "log"
lombok.log.fieldName = log

# Plain Java already covers these, or they hide behaviour; using them fails the compilation
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.experimental.flagUsage = error
